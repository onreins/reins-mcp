{
  "name": "reins-mcp",
  "version": "1.0.0",
  "description": "Let any AI agent trade through a Mandate on Arc: an MCP server, a JavaScript SDK and a reference agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reins-mcp": "src/mcp-server.js"
  },
  "main": "src/sdk.js",
  "scripts": {
    "mcp": "node src/mcp-server.js",
    "agent:fx": "node examples/fx-reversion.js",
    "chain": "hardhat node --port 8545",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "viem": "^2.56.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "hardhat": "^2.29.1"
  }
}
